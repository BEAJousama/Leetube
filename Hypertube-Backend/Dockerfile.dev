# Development stage - single stage for dev with all dependencies
FROM node:22-alpine


WORKDIR /app

# Install system dependencies including netcat for database connectivity check
RUN apk add --no-cache openssl dumb-init netcat-openbsd ffmpeg

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S hypertube -u 1001

# Copy package files
COPY package*.json ./
COPY pnpm-lock.yaml* ./

# Copy Prisma schema
COPY ./prisma ./prisma

# Install pnpm and ALL dependencies (including dev dependencies)
RUN npm install -g pnpm@9
RUN pnpm config set ignore-scripts false
RUN pnpm install --no-frozen-lockfile

# Generate Prisma client
RUN pnpm prisma generate

# Create necessary directories
RUN mkdir -p /app/logs /app/uploads /app/downloads
RUN chown -R hypertube:nodejs /app

# Copy source code
COPY --chown=hypertube:nodejs . .

# Make entrypoint script executable
RUN chmod +x /app/scripts/docker-entrypoint.sh

# Switch to non-root user
USER hypertube

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Start the development server with database setup
ENTRYPOINT ["dumb-init", "--", "/app/scripts/docker-entrypoint.sh"]
CMD ["pnpm", "dev"]
