# Application Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
BASE_URL=http://localhost:3000

# Database Configuration
DATABASE_URL="postgresql://hypertube_user:hypertube_password@localhost:5432/hypertube"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# OAuth Configuration - Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# OAuth Configuration - Twitter
TWITTER_CLIENT_ID="your-twitter-client-id"
TWITTER_CLIENT_SECRET="your-twitter-client-secret"
TWITTER_REDIRECT_URI="http://localhost:3000/api/auth/oauth/twitter/callback"

# External APIs
TMDB_API_KEY="your-tmdb-api-key"
TMDB_TIMEOUT=15000
TMDB_RETRY_ATTEMPTS=2
TMDB_RETRY_DELAY=1000
OPENSUBTITLES_API_KEY="your-opensubtitles-api-key"
OPENSUBTITLES_URL="https://api.opensubtitles.com/api/v1"
OPENSUBTITLES_API_KEY="your-opensubtitles-api-key"

# Email Configuration (for verification and password reset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@hypertube.com"
FROM_NAME="Hypertube"

# File Storage Configuration
UPLOAD_PATH="./uploads"
DOWNLOAD_PATH="./downloads"
MAX_FILE_SIZE="10485760"  # 10MB in bytes
MAX_DOWNLOAD_SIZE="5368709120"  # 5GB in bytes

# Redis Configuration (optional)
REDIS_URL="redis://localhost:6379"
REDIS_TTL=3600  # 1 hour in seconds

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Security Configuration
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SESSION_SECRET="your-session-secret-change-in-production"

# Development Configuration
ENABLE_SWAGGER=true
ENABLE_CORS=true
TRUST_PROXY=false
