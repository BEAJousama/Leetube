model MovieSource {
  id          String    @id @default(cuid())
  movieId     String    @map("movie_id")
  sourceName  String    @map("source_name")  // e.g., "YTS", "RARBG", "1337x"
  sourceId    String    @map("source_id")    // external source ID
  magnetLink  String?   @map("magnet_link") @db.Text
  torrentUrl  String?   @map("torrent_url") @db.Text
  quality     String?   // e.g., "1080p", "720p"
  fileSize    BigInt?   @map("file_size")
  seeders     Int?
  leechers    Int?
  isVerified  Boolean   @default(false) @map("is_verified")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  movie       Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([movieId, sourceName, sourceId])
  @@map("movie_sources")
}

model Subtitle {
  id            String    @id @default(cuid())
  movieId       String    @map("movie_id")
  language      String    // e.g., "en", "fr", "es"
  languageName  String    @map("language_name") // e.g., "English", "French"
  format        String    @default("srt")       // subtitle format
  url           String?   @db.Text              // download URL
  filePath      String?   @map("file_path") @db.Text
  fileSize      Int?      @map("file_size")
  isDefault     Boolean   @default(false) @map("is_default")
  isDownloaded  Boolean   @default(false) @map("is_downloaded")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  movie         Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([movieId, language])
  @@map("subtitles")
}

// ============================================================================
// COMMENT & RATING MODELS
// ============================================================================

model Comment {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  movieId       String    @map("movie_id")
  content       String    @db.Text
  isEdited      Boolean   @default(false) @map("is_edited")
  editedAt      DateTime? @map("edited_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie         Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Rating {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  movieId   String    @map("movie_id")
  rating    Int       // 1-5 stars
  review    String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("ratings")
}
