# HyperTube Frontend Environment Variables
# Copy this file to .env.local and update the values for your environment

# ===========================================
# API Configuration
# ===========================================
# Backend API base URL (without trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# Frontend application URL (used for OAuth redirects)
VITE_APP_URL=http://localhost:3001

# ===========================================
# App Configuration
# ===========================================
# Application name and version
VITE_APP_NAME=HyperTube
VITE_APP_VERSION=1.0.0

# ===========================================
# Development Configuration
# ===========================================
# Vite dev server configuration
VITE_HOST=localhost
VITE_PORT=5173

# ===========================================
# Advanced Configuration (Optional)
# ===========================================
# Custom refresh token endpoint
# VITE_REFRESH_TOKEN_URL=http://localhost:3000/api/auth/refresh

# ===========================================
# Docker Override (Optional)
# ===========================================
# Use these when running in Docker
# VITE_HOST=0.0.0.0
# VITE_PORT=5173